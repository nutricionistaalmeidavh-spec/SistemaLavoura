{
  "schemaVersion": 1,
  "id": "agro-lavoura",
  "corePolicy": {
    "selfHosted": true,
    "openSourceCore": true,
    "requiredPaidServices": []
  },
  "utilidades": {
    "required": [
      "artisys-storage",
      "artisys-backup",
      "artisys-auth-rbac",
      "artisys-settings",
      "artisys-alerts",
      "artisys-feature-flags",
      "artisys-licensing"
    ],
    "optional": [
      "artisys-planning",
      "artisys-inventory",
      "artisys-reporting",
      "artisys-capture",
      "artisys-pwa-runtime",
      "artisys-sync",
      "artisys-catalog",
      "artisys-audit-log",
      "artisys-files",
      "artisys-importer"
    ]
  },
  "targets": [
    "desktop",
    "pwa"
  ],
  "migrations": "./migrations",
  "seeds": "./seeds",
  "branding": "./branding/brand.json",
  "editions": {
    "default": "complete",
    "supported": [
      "essential",
      "management",
      "complete"
    ],
    "entitlements": "./src/entitlements.js",
    "licensing": "./src/licensing.js"
  }
}
